# dependencies
/node_modules

# build output
/.next/
/out/
/dist/
/release/

# testing
/coverage

# misc
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env
.env*

# editors
.idea
.vscode/*
!.vscode/extensions.json

# The apt signing key is written by CI at build time and must never be committed.
build/keyring/*
!build/keyring/.gitkeep

# Working notes stay local; only the screenshot the README renders is tracked.
docs/*.md

# Agent and assistant instructions stay local, like docs.
AGENTS.md
CLAUDE.md
.claude/

# Throwaway Electron probe scripts, run from the repo root so their requires resolve.
*check.cjs
probe.cjs

# Smoke runs launch the built app; nothing they produce belongs in the repo.
/smoke-results/
test-results/
