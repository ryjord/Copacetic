<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Electron's own renderer processes need these two under the hardened
    runtime. Nothing is granted that a web page cannot ask for: no address
    book, and no ability to load unsigned libraries.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Outbound network access, which is the entire point of a browser. -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!--
    A site can ask for the camera, microphone or location, and is only given
    them after the person allows it in Copacetic and macOS has asked too.
    Without these the request fails under the hardened runtime with no prompt.
  -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.personal-information.location</key>
  <true/>

  <!-- Writing downloads to the folder the user picks. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
