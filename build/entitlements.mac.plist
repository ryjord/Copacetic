<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Electron's own renderer processes need these two under the hardened
    runtime. Nothing else is granted: no camera, no microphone, no address
    book, and no ability to load unsigned libraries.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Outbound network access, which is the entire point of a browser. -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- Writing downloads to the folder the user picks. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
