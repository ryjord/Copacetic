{
  "name": "copacetic",
  "productName": "Copacetic",
  "version": "2.0.0",
  "description": "A calm, honest browser that shows you the true state of every page.",
  "author": {
    "name": "Riley Jordan",
    "email": "rileyjordan21@hotmail.com"
  },
  "license": "MIT",
  "private": true,
  "main": "dist/electron/main/index.js",
  "scripts": {
    "prepare": "husky",
    "predev": "node scripts/build-licences.mjs",
    "dev": "cross-env NODE_ENV=development concurrently -k -n next,main,preload,electron -c cyan,magenta,yellow,green \"next dev --port 3000\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"npm run build:preload -- --watch\" \"wait-on http://localhost:3000 dist/electron/main/index.js dist/electron/preload/index.js && electron .\"",
    "dev:renderer": "next dev --port 3000",
    "build": "npm run build:renderer && npm run build:main && npm run filters:build",
    "build:renderer": "node scripts/build-licences.mjs && next build",
    "build:main": "npm run clean:dist && tsc -p tsconfig.electron.json && npm run build:preload && node scripts/build-translation-engine.mjs",
    "build:preload": "esbuild electron/preload/index.ts electron/preload/extensions/worker.ts electron/preload/extensions/page.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outbase=electron/preload --outdir=dist/electron/preload",
    "start": "cross-env NODE_ENV=production electron .",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.preload.json && tsc -p tsconfig.smoke.json && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "generate:psl": "node scripts/generate-public-suffix-list.mjs",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "smoke": "vitest run --config vitest.smoke.config.mts",
    "filters:update": "node scripts/update-filters.mjs",
    "filters:build": "node scripts/build-filters.mjs",
    "measure": "node scripts/measure-performance.mjs",
    "check:packaged": "node scripts/check-packaged-app.mjs",
    "pretest": "node scripts/check-node.mjs",
    "preverify": "node scripts/check-node.mjs"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@browsermt/bergamot-translator": "0.4.9",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@mozilla/readability": "0.6.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.6.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "prettier": "^3.4.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.4",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "appId": "uk.co.ryjord.copacetic",
    "productName": "Copacetic",
    "copyright": "Copyright © 2026 Riley Jordan",
    "publish": {
      "provider": "github",
      "owner": "ryjord",
      "repo": "Copacetic",
      "releaseType": "release"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asarUnpack": [
      "dist/electron/translation/engine/**"
    ],
    "files": [
      "dist/electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "electronFuses": {
      "resetAdHocDarwinSignature": true,
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0",
      "extraResources": [
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "LICENSES.chromium.html"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Web site URL",
            "CFBundleURLSchemes": [
              "http",
              "https"
            ],
            "CFBundleTypeRole": "Viewer"
          }
        ],
        "LSHandlerRank": "Owner",
        "LSApplicationCategoryType": "public.app-category.productivity",
        "NSCameraUsageDescription": "Websites can ask to use your camera. Copacetic asks you before any site gets it.",
        "NSMicrophoneUsageDescription": "Websites can ask to use your microphone. Copacetic asks you before any site gets it.",
        "NSLocationUsageDescription": "Websites can ask for your location. Copacetic asks you before any site gets it.",
        "NSLocationWhenInUseUsageDescription": "Websites can ask for your location. Copacetic asks you before any site gets it.",
        "NSScreenCaptureUsageDescription": "Websites can ask to share your screen. You choose what is shared, each time."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "text/html"
      ]
    },
    "deb": {
      "afterInstall": "build/deb/after-install.sh",
      "afterRemove": "build/deb/after-remove.sh"
    },
    "extraResources": [
      {
        "from": "build/keyring",
        "to": ".",
        "filter": [
          "copacetic-archive-keyring.gpg",
          "copacetic-apt-source"
        ]
      }
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  }
}
